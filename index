    async function fetchPrices() {
      const rawText = document.getElementById("urlInput").value.trim();
      const urlMatches = rawText.match(/https?:\/\/[^\s\n]*mercari\.com[^\s\n]*/gi);

      if (!urlMatches || urlMatches.length === 0) {
        alert("文字中未偵測到有效的 Mercari 商品網址！");
        return;
      }

      const urls = [...new Set(urlMatches.map(u => u.trim()))];
      const fetchBtn = document.getElementById("fetchBtn");
      fetchBtn.disabled = true;
      fetchBtn.innerHTML = `<span>已識別 ${urls.length} 個網址，解析中...</span>`;

      try {
        const response = await fetch(WORKER_API_URL, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ urls })
        });

        const result = await response.json();
        if (result.success) {
          fetchedItems = result.data;
          renderItems();
          calculateTotal();
        } else {
          alert("自動抓取失敗：" + (result.error || "伺服器無回應"));
        }
      } catch (err) {
        alert("連線失敗，請檢查網路。");
      } finally {
        fetchBtn.disabled = false;
        fetchBtn.innerHTML = `<span>自動辨識網址並報價</span>`;
      }
    }

