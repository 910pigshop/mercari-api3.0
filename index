    // 計算大宗折扣階梯 (總張數 >= 50 階梯2 | >= 25 階梯1 | 否則階梯0)
    function getTierIndex() {
      const totalCount = photoCardCounts.reduce((a, b) => a + b, 0);
      if (totalCount >= 50) return 2;
      if (totalCount >= 25) return 1;
      return 0;
    }

    function calculatePhotoCards() {
      const totalCount = photoCardCounts.reduce((a, b) => a + b, 0);
      const tierIdx = getTierIndex();

      let totalTwd = 0;
      let totalProfit = 0;
      const costRate = parseFloat(document.getElementById("costRate").value) || 0.21;

      photoCardDefs.forEach((def, index) => {
        const count = photoCardCounts[index] || 0;
        if (count > 0) {
          const unitPrice = def.prices[tierIdx];
          const itemTwd = count * unitPrice;
          totalTwd += itemTwd;

          // 相卡利潤公式：相卡報價 - (成本匯率 * 日幣成本 * 張數)
          const itemCost = costRate * def.jpyCost * count;
          totalProfit += (itemTwd - itemCost);
        }
      });

      // 小數點進1並取整數
      totalTwd = Math.ceil(totalTwd);
      totalProfit = Math.ceil(totalProfit);

      document.getElementById("photoTotalCount").innerText = totalCount;
      document.getElementById("photoTotalTwd").innerText = `NT$ ${totalTwd.toLocaleString()}`;
      document.getElementById("photoTotalProfit").innerText = `NT$ ${totalProfit.toLocaleString()}`;

      const badge = document.getElementById("tierBadge");
      if (tierIdx === 2) {
        badge.innerText = "🔥 50+張特價";
        badge.className = "ml-1 px-2 py-0.5 rounded text-[10px] bg-red-500 text-white font-bold";
