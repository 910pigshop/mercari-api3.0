      }

      let validCount = 0;

      if (tabSource === 1 || tabSource === 2) {
        const targetItems = tabSource === 1 ? fetchedItems : generalManualItems;
        const totalTwdVal = document.getElementById(tabSource === 1 ? "totalTwd" : "totalTwdGeneral").innerText.replace("NT$", "").trim();

        targetItems.forEach((item, i) => {
          const itemPrice = item.price || 0;
          const itemType = item.type || 'used';

          if (tabSource === 1 ? (item.success || itemPrice > 0) : (itemPrice > 0)) {
            validCount++;
            const title = item.manualTitle || item.title || `商品 (${i + 1})`;
            const rawUrl = item.manualJpUrl || item.jpUrl || item.originalUrl || item.url || "";
            const displayUrl = rawUrl.trim();
            const singleTwd = calculateSingleTwd(itemPrice, itemType);

            text += `${validCount}. ${title} ($${singleTwd.toLocaleString()})\n`;
            if (displayUrl !== "") {
              text += `   ${displayUrl}\n`;
            }
          }
        });

        if (shippingNote) text += `${shippingNote}\n`;
        text += `--------------------\n`;
        text += `總計金額：NT$ ${totalTwdVal}\n`;
      } else if (tabSource === 3) {
        // 相卡報價複製
        const tierIdx = getTierIndex();
        photoCardDefs.forEach((def, index) => {
          const count = photoCardCounts[index] || 0;
          if (count > 0) {
            validCount++;
            const unitPrice = def.prices[tierIdx];
            const itemTwd = count * unitPrice;
            text += `${validCount}. ${def.name} x${count} ($${itemTwd.toLocaleString()})\n`;
          }
        });

        if (shippingNote) text += `${shippingNote}\n`;
        text += `--------------------\n`;
        const photoTotalTwd = document.getElementById("photoTotalTwd").innerText.replace("NT$", "").trim();
        text += `總計金額：NT$ ${photoTotalTwd}\n`;
      } else if (tabSource === 4) {
        // 純數字商品複製
        numberItems.forEach((val, index) => {
          if (val > 0) {
            validCount++;
            const singleTwd = calculateSingleTwd(val, 'used');
            text += `${validCount}. 商品 (${index + 1}) ($${singleTwd.toLocaleString()})\n`;
          }
        });

        if (shippingNote) text += `${shippingNote}\n`;
        text += `--------------------\n`;
        const numberTotalTwd = document.getElementById("numberTotalTwd").innerText.replace("NT$", "").trim();
        text += `總計金額：NT$ ${numberTotalTwd}\n`;
      }

      if (footerText) {
        text += `${footerText}`;
      }

      navigator.clipboard.writeText(text).then(() => {
        document.getElementById(`previewText${tabSource}`).innerText = text;
        document.getElementById(`previewBox${tabSource}`).classList.remove("hidden");
        alert("報價文字已成功複製到剪貼簿！");
      });
    }
  </script>
</body>
</html>
