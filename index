    // 抓取當天國際即時匯率
    async function fetchRealtimeRate() {
      const display = document.getElementById("realtimeRateDisplay");
      display.innerText = "讀取中...";
      try {
        const res = await fetch("https://open.er-api.com/v6/latest/JPY");
        if (res.ok) {
          const data = await res.json();
          const twdRate = data?.rates?.TWD;
          if (twdRate) {
            display.innerText = `1 JPY ≈ ${twdRate.toFixed(4)} TWD`;
            return;
          }
        }
        display.innerText = "無法取得即時匯率";
      } catch (e) {
        display.innerText = "無法取得即時匯率";
      }
    }

    // 0/5 進位邏輯
    function adjustRoundPrice(val) {
      let rounded = Math.round(val);
      let lastDigit = rounded % 10;

      if (lastDigit >= 1 && lastDigit <= 4) {
        return rounded + (5 - lastDigit);
      } else if (lastDigit >= 6 && lastDigit <= 9) {
        return rounded + (10 - lastDigit);
      }
      return rounded;
    }

    // 計算單件台幣金額
    function calculateSingleTwd(jpyPrice, type = 'used') {
      if (!jpyPrice || jpyPrice <= 0) return 0;
      const rate = parseFloat(document.getElementById("rate").value) || 0;
      const feePercent = type === 'shop' 
        ? (parseFloat(document.getElementById("shopFeePercent").value) || 0)
        : (parseFloat(document.getElementById("usedFeePercent").value) || 0);

      const rawTwd = jpyPrice * rate * (1 + feePercent / 100);
      return adjustRoundPrice(rawTwd);
    }

